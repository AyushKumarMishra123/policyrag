# ==============================================================================
# Mirai Autonomous Student Policy Advisor - Configuration Template
# ==============================================================================

# Google Gemini API Key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Generator Model (gemini-3.8-flash recommended as per problem statement)
GEMINI_MODEL=gemini-3.8-flash

# Embeddings Model (text-embedding-004 as per problem statement)
EMBEDDING_MODEL=models/text-embedding-004

# LLM Generation Temperature (0.0 for strict deterministic factuality)
TEMPERATURE=0.0

# Path to the Mirai Student Policy Handbook PDF
HANDBOOK_PATH=data/Mirai_SoT_Policy_Handbook_2026.pdf

# Vector Database Persistence Directory and Collection Name
CHROMA_PERSIST_DIR=chroma_db
CHROMA_COLLECTION_NAME=mirai_policy_handbook

# Text Chunking Settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval Settings
RETRIEVER_K=4
USE_MULTI_QUERY=true

# Application Layer Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://127.0.0.1:8000
REQUEST_TIMEOUT_SECONDS=30.0
